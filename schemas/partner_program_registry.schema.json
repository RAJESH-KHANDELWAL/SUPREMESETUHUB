{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUPREME Partner Program Registry Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_id", "provider_id", "provider_name", "program_type", "referral_url", "status", "tracking_mode"],
  "properties": {
    "program_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "provider_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "program_type": {"type": "string", "enum": ["REFERRAL", "AFFILIATE", "RESELLER", "PARTNER"]},
    "ecosystem_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "owner_brand": {"type": "string", "minLength": 1, "maxLength": 200},
    "referral_url": {"type": "string", "format": "uri"},
    "provider_advertised_reward": {"type": "string", "maxLength": 300},
    "referred_friend_offer": {"type": "string", "maxLength": 300},
    "currency_context": {"type": "string", "maxLength": 300},
    "status": {"type": "string", "enum": ["DRAFT", "CONFIGURED_NOT_VERIFIED_LIVE", "ACTIVE_VERIFIED", "PAUSED", "RETIRED"]},
    "tracking_mode": {"type": "string", "enum": ["PROVIDER_ATTRIBUTION", "APPROVED_CALLBACK", "APPROVED_API"]},
    "provider_dashboard_is_source_of_truth": {"type": "boolean"},
    "purchases_visible_to_supreme_without_provider_api": {"type": "boolean"},
    "capture_personal_data_without_consent": {"const": false},
    "last_reviewed_date": {"type": "string", "format": "date"},
    "notes": {"type": "array", "items": {"type": "string", "maxLength": 1000}}
  }
}
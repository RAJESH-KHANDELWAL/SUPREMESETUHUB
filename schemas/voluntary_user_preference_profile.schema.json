{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUPREME Voluntary User Preference Profile",
  "description": "Optional, user-declared preferences. Not a psychological diagnosis or inferred sensitive profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "user_control", "updated_at"],
  "properties": {
    "profile_id": { "type": "string", "minLength": 1, "description": "Pseudonymous identifier where practical; avoid direct identity." },
    "user_control": {
      "type": "object",
      "required": ["personalization_enabled", "can_skip", "can_reset"],
      "properties": {
        "personalization_enabled": { "type": "boolean", "default": false },
        "can_skip": { "const": true },
        "can_reset": { "const": true },
        "consent_record_id": { "type": "string" },
        "notice_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scripts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "input_modes": { "type": "array", "items": { "type": "string", "enum": ["text", "voice", "keyboard", "assistive_technology"] }, "uniqueItems": true },
        "accessibility_options": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "session_goals": { "type": "array", "items": { "type": "string", "enum": ["learn", "create", "find_service", "connect", "shop", "business", "entertainment", "explore", "other"] }, "uniqueItems": true },
        "discovery_style": { "type": "array", "items": { "type": "string", "enum": ["direct_search", "guided_steps", "recommendations", "independent_browse"] }, "uniqueItems": true },
        "content_formats": { "type": "array", "items": { "type": "string", "enum": ["short_text", "long_text", "audio", "video", "examples", "step_by_step"] }, "uniqueItems": true },
        "personalization_level": { "type": "string", "enum": ["off", "minimal", "selected_interests"] },
        "low_bandwidth_mode": { "type": "boolean" },
        "experience_level_by_topic": { "type": "object", "additionalProperties": { "type": "string", "enum": ["new", "some_experience", "experienced", "prefer_not_to_say"] } },
        "selected_interests": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "recommendation_explanations": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "data_lifecycle": {
      "type": "object",
      "properties": {
        "purpose": { "type": "string" },
        "retention_until": { "type": "string", "format": "date-time" },
        "deletion_requested_at": { "type": "string", "format": "date-time" },
        "last_confirmed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "source", "scope", "reviewed_at"],
        "properties": {
          "kind": { "type": "string", "enum": ["PUBLIC_RESEARCH", "SUPREME_VOLUNTARY_RESEARCH", "PRODUCT_FEEDBACK_AGGREGATE", "HYPOTHESIS", "VALIDATED_FOR_SCOPE", "RETIRED"] },
          "source": { "type": "string" },
          "scope": { "type": "string" },
          "limitations": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "medium", "high", "not_assessed"] },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "review_due_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  }
}
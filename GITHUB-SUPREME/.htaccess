Options -Indexes

<FilesMatch "^(hosts\.json|domains\.json|.*\.local\.json)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|ini|log|bak|sql|pem|key)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

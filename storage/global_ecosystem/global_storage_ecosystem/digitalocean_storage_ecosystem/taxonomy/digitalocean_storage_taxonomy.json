{
  "schema_version": "1.0.0",
  "ecosystem_id": "DIGITALOCEAN_STORAGE_ECOSYSTEM",
  "provider": "DIGITALOCEAN",
  "naming_rule": "DIGITALOCEAN_<CATEGORY>_STORAGE_ECOSYSTEM",
  "classification_note": "DigitalOcean storage taxonomy. Category entries are metadata namespaces, not proof that every capability is an independently available DigitalOcean product or enabled on an account.",
  "groups": [
    {
      "group": "OBJECT_AND_FILE_STORAGE",
      "categories": [
        "SPACES_OBJECT_STORAGE",
        "SPACES_CDN",
        "OBJECT_LIFECYCLE",
        "OBJECT_VERSIONING",
        "OBJECT_METADATA"
      ]
    },
    {
      "group": "BLOCK_AND_COMPUTE_STORAGE",
      "categories": [
        "BLOCK_STORAGE_VOLUMES",
        "DROPLET_LOCAL_STORAGE",
        "SNAPSHOTS",
        "BACKUPS"
      ]
    },
    {
      "group": "MANAGED_DATA_AND_DATABASE_STORAGE",
      "categories": [
        "MANAGED_DATABASE_STORAGE",
        "DATABASE_BACKUPS",
        "DATABASE_SNAPSHOTS"
      ]
    },
    {
      "group": "CONTAINER_AND_APPLICATION_ARTIFACT_STORAGE",
      "categories": [
        "CONTAINER_REGISTRY",
        "KUBERNETES_PERSISTENT_STORAGE",
        "APP_PLATFORM_ARTIFACTS"
      ]
    },
    {
      "group": "PLATFORM_AND_GOVERNANCE",
      "categories": [
        "STORAGE_SECURITY",
        "ACCESS_CONTROL",
        "ENCRYPTION",
        "REGIONAL_STORAGE",
        "BILLING_AND_USAGE_METADATA",
        "AUDIT_AND_RETENTION"
      ]
    }
  ],
  "entry_status": "CATALOG_ONLY",
  "provider_product_verified": false,
  "governance": {
    "security": [
      "least_privilege",
      "encryption_in_transit_and_at_rest_where_supported",
      "audit_logging",
      "secret_manager_only"
    ],
    "data_lifecycle": [
      "retention_policy",
      "backup_verification",
      "deletion_verification"
    ],
    "connectivity": "Require official API support, authorized credentials, live health checks and end-to-end tests before enabling operations."
  }
}

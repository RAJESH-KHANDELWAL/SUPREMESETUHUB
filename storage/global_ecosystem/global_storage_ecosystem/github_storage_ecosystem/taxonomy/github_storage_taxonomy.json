{
  "schema_version": "1.0.0",
  "ecosystem_id": "GITHUB_STORAGE_ECOSYSTEM",
  "provider": "GITHUB",
  "naming_rule": "GITHUB_<CATEGORY>_STORAGE_ECOSYSTEM",
  "classification_note": "GitHub storage taxonomy and metadata catalog. Category entries describe data domains and metadata surfaces; not all are standalone GitHub products or independent storage services.",
  "groups": [
    {
      "group": "REPOSITORY_AND_SOURCE_STORAGE",
      "categories": [
        "REPOSITORIES",
        "GIT_OBJECTS",
        "COMMITS",
        "BRANCHES",
        "TAGS",
        "RELEASES",
        "SOURCE_CODE",
        "LARGE_FILE_STORAGE"
      ]
    },
    {
      "group": "COLLABORATION_AND_REVIEW_STORAGE",
      "categories": [
        "PULL_REQUESTS",
        "ISSUES",
        "DISCUSSIONS",
        "CODE_REVIEWS",
        "COMMENTS",
        "PROJECTS_AND_METADATA"
      ]
    },
    {
      "group": "BUILD_AND_DELIVERY_STORAGE",
      "categories": [
        "GITHUB_ACTIONS_ARTIFACTS",
        "WORKFLOW_LOGS",
        "PACKAGES_AND_REGISTRY",
        "CONTAINER_IMAGES",
        "RELEASE_ASSETS"
      ]
    },
    {
      "group": "DEVELOPMENT_AND_SECURITY_METADATA",
      "categories": [
        "CODESPACES_METADATA",
        "WEBHOOK_DELIVERY_METADATA",
        "SECURITY_ADVISORIES",
        "DEPENDABOT_ALERTS",
        "CODE_SCANNING_RESULTS",
        "SECRET_SCANNING_METADATA"
      ]
    },
    {
      "group": "IDENTITY_AND_GOVERNANCE_METADATA",
      "categories": [
        "ORGANIZATIONS_AND_TEAMS",
        "ACCESS_CONTROL_AND_PERMISSIONS",
        "AUDIT_LOGS",
        "REPOSITORY_SETTINGS",
        "BACKUP_AND_RETENTION_METADATA"
      ]
    }
  ],
  "entry_status": "CATALOG_ONLY",
  "provider_product_verified": false,
  "governance": {
    "security": [
      "least_privilege",
      "token_permissions_scoped_to_required_resources",
      "secret_manager_only",
      "audit_logging"
    ],
    "data_lifecycle": [
      "retention_policy",
      "backup_verification",
      "repository_visibility_controls",
      "artifact_expiration"
    ],
    "connectivity": "Use approved GitHub API integrations with authorized scopes. Verify endpoints, permissions and end-to-end behavior before enabling operations."
  }
}

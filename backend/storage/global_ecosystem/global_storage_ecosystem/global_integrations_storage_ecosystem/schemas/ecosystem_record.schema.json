{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLOBAL INTEGRATIONS storage ecosystem record",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "name"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

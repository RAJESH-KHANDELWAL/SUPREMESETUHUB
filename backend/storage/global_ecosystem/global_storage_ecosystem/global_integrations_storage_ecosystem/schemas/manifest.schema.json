{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLOBAL_INTEGRATIONS_STORAGE_ECOSYSTEM manifest",
  "type": "object",
  "required": [
    "schema_version",
    "ecosystem_id",
    "package_name",
    "provider",
    "taxonomy_file",
    "category_index_file",
    "taxonomy_only",
    "external_connection_state"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "ecosystem_id": {
      "const": "GLOBAL_INTEGRATIONS_STORAGE_ECOSYSTEM"
    },
    "package_name": {
      "const": "global_integrations_storage_ecosystem"
    },
    "provider": {
      "const": "GLOBAL INTEGRATIONS"
    },
    "taxonomy_file": {
      "const": "taxonomy/global_integrations_storage_taxonomy.json"
    },
    "category_index_file": {
      "const": "category_index.json"
    },
    "taxonomy_only": {
      "const": "boolean"
    },
    "external_connection_state": {
      "enum": [
        "NOT_CONFIGURED",
        "VERIFIED"
      ]
    }
  },
  "additionalProperties": true
}

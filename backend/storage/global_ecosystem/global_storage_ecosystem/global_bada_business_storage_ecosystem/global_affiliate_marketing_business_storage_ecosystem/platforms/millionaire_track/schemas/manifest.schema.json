{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "platform_id",
    "connection_state"
  ],
  "properties": {
    "platform_id": {
      "const": "MILLIONAIRE_TRACK"
    },
    "connection_state": {
      "enum": [
        "NOT_CONFIGURED",
        "CONNECTED",
        "DEGRADED",
        "DISCONNECTED"
      ]
    },
    "external_connections_verified": {
      "type": "boolean"
    },
    "storage_operations_enabled": {
      "type": "boolean"
    }
  }
}

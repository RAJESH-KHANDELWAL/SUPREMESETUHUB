{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ecosystem_id",
    "business_parent",
    "connection_state"
  ],
  "properties": {
    "ecosystem_id": {
      "const": "YOUTAG_WELLNESS_APP"
    },
    "business_parent": {
      "const": "GLOBAL_YOUTAG_BUSINESS_STORAGE_ECOSYSTEM"
    },
    "connection_state": {
      "enum": [
        "NOT_CONFIGURED",
        "CONNECTED",
        "DEGRADED",
        "DISCONNECTED"
      ]
    },
    "storage_operations_enabled": {
      "type": "boolean"
    }
  }
}

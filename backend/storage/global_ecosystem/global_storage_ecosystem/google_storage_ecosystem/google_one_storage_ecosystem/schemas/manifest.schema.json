{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GOOGLE_ONE_STORAGE_ECOSYSTEM manifest",
  "type": "object",
  "required": [
    "ecosystem_id",
    "provider",
    "connection_state"
  ],
  "properties": {
    "ecosystem_id": {
      "const": "GOOGLE_ONE_STORAGE_ECOSYSTEM"
    },
    "provider": {
      "const": "GOOGLE"
    },
    "category": {
      "const": "ONE"
    },
    "connection_state": {
      "enum": [
        "NOT_CONFIGURED",
        "CONNECTED",
        "DEGRADED",
        "DISCONNECTED"
      ]
    },
    "provider_product_verified": {
      "type": "boolean"
    },
    "storage_operations_enabled": {
      "type": "boolean"
    }
  }
}

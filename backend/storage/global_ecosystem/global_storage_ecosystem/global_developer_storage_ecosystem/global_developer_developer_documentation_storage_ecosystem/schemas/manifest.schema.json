{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLOBAL DEVELOPER storage category manifest",
  "type": "object",
  "required": [
    "schema_version",
    "ecosystem_id",
    "implementation_state",
    "external_connection_state",
    "storage_operations_enabled"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "ecosystem_id": {
      "type": "string"
    },
    "implementation_state": {
      "type": "string"
    },
    "external_connection_state": {
      "const": "NOT_CONFIGURED"
    },
    "storage_operations_enabled": {
      "const": false
    }
  },
  "additionalProperties": true
}

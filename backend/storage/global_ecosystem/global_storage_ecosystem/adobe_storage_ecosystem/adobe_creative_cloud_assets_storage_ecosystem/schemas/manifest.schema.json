{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adobe Creative Cloud Assets Storage manifest",
  "type": "object",
  "required": [
    "ecosystem_id",
    "provider",
    "implementation_state",
    "external_connection_state"
  ],
  "properties": {
    "ecosystem_id": {
      "const": "ADOBE_CREATIVE_CLOUD_ASSETS_STORAGE_ECOSYSTEM"
    },
    "provider": {
      "const": "ADOBE"
    },
    "implementation_state": {
      "type": "string"
    },
    "external_connection_state": {
      "enum": [
        "NOT_CONFIGURED",
        "CONNECTED",
        "ERROR"
      ]
    },
    "storage_operations_enabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}

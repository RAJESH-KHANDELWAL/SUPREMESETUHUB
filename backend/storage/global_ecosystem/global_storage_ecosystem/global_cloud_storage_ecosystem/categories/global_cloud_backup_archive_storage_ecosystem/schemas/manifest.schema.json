{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backup and Archive Storage manifest",
  "type": "object",
  "required": [
    "schema_version",
    "category_id",
    "ecosystem_id",
    "connection_state",
    "storage_operations_enabled"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "category_id": {
      "const": "BACKUP_ARCHIVE_STORAGE"
    },
    "ecosystem_id": {
      "const": "GLOBAL_CLOUD_STORAGE_ECOSYSTEM"
    },
    "connection_state": {
      "const": "NOT_CONFIGURED"
    },
    "storage_operations_enabled": {
      "const": false
    }
  },
  "additionalProperties": true
}

# One physical central database for SUPREMESETUHUB and all four identity gates.
# Set the exact host, database name, user and port from Hostinger hPanel.
SUPREME_DB_HOST=YOUR_EXACT_HOSTINGER_MYSQL_HOST
SUPREME_DB_PORT=3306
SUPREME_DB_NAME=u664492673_SUPREMESETUHUB
SUPREME_DB_USER=u664492673_SUPREMESETUHUB
SUPREME_DB_PASSWORD=SET_PRIVATELY
SUPREME_DB_CONNECT_TIMEOUT=10
SUPREME_DB_SSL_REQUIRED=false
SUPREME_DB_SSL_CA=

# The four identity gates do NOT have separate database credentials.
# They use identity_code scopes inside SUPREMESETUHUB.
# Never put real passwords in this file or commit them to GitHub.

# CENTRAL DATABASE — SUPREMESETUHUB
# One physical database shared by the main system and four logical identity gates.
# Confirm the exact values in Hostinger hPanel > Databases before deployment.
SUPREME_DB_HOST=YOUR_EXACT_HOSTINGER_MYSQL_HOST
SUPREME_DB_PORT=3306
# Proposed same-name convention: database name and username use the same label.
# If Hostinger shows different actual values, copy the exact hPanel values instead.
SUPREME_DB_NAME=u664492673_SUPREMESETUHUB
SUPREME_DB_USER=u664492673_SUPREMESETUHUB
# Put the real database user's password in Render Environment or GitHub Actions Secrets.
SUPREME_DB_PASSWORD=SET_PRIVATELY
SUPREME_DB_CONNECT_TIMEOUT=10
SUPREME_DB_SSL_REQUIRED=false
SUPREME_DB_SSL_CA=

# The four identity gates do NOT have separate physical DBs or DB credentials.
# They share this database and are separated by identity_code access scopes.
# Never put real passwords in this file or commit them to GitHub.

# SUPREMESETUHUB — MAIN + FOUR BRAND CONFIGURATION NAMING
# These are the exact logical names/values requested for the repository structure.
# Before a live connection, replace HOST/NAME/USER with the exact values provisioned
# by Hostinger hPanel. The labels below are naming placeholders, not verified hosts/accounts.
# Never commit real passwords.

# 1. MAIN — SUPREMESETUHUB
SUPREMESETUHUB_DB_HOST=SUPREMESETUHUB
SUPREMESETUHUB_DB_NAME=SUPREMESETUHUB
SUPREMESETUHUB_DB_USER=SUPREMESETUHUB
SUPREMESETUHUB_DB_PASSWORD=
SUPREMESETUHUB_DB_PORT=

# 2. BRAND 1 — RAJESHKHANDELWALOFFICIAL
RAJESHKHANDELWALOFFICIAL_DB_HOST=RAJESHKHANDELWALOFFICIAL
RAJESHKHANDELWALOFFICIAL_DB_NAME=RAJESHKHANDELWALOFFICIAL
RAJESHKHANDELWALOFFICIAL_DB_USER=RAJESHKHANDELWALOFFICIAL
RAJESHKHANDELWALOFFICIAL_DB_PASSWORD=
RAJESHKHANDELWALOFFICIAL_DB_PORT=

# 3. BRAND 2 — RAJESHKHANDELWAL
RAJESHKHANDELWAL_DB_HOST=RAJESHKHANDELWAL
RAJESHKHANDELWAL_DB_NAME=RAJESHKHANDELWAL
RAJESHKHANDELWAL_DB_USER=RAJESHKHANDELWAL
RAJESHKHANDELWAL_DB_PASSWORD=
RAJESHKHANDELWAL_DB_PORT=

# 4. BRAND 3 — DRRAJESHKHANDELWALIBCOFFICIAL
DRRAJESHKHANDELWALIBCOFFICIAL_DB_HOST=DRRAJESHKHANDELWALIBCOFFICIAL
DRRAJESHKHANDELWALIBCOFFICIAL_DB_NAME=DRRAJESHKHANDELWALIBCOFFICIAL
DRRAJESHKHANDELWALIBCOFFICIAL_DB_USER=DRRAJESHKHANDELWALIBCOFFICIAL
DRRAJESHKHANDELWALIBCOFFICIAL_DB_PASSWORD=
DRRAJESHKHANDELWALIBCOFFICIAL_DB_PORT=

# 5. BRAND 4 — DRRAJESHKHANDELWALIBC
DRRAJESHKHANDELWALIBC_DB_HOST=DRRAJESHKHANDELWALIBC
DRRAJESHKHANDELWALIBC_DB_NAME=DRRAJESHKHANDELWALIBC
DRRAJESHKHANDELWALIBC_DB_USER=DRRAJESHKHANDELWALIBC
DRRAJESHKHANDELWALIBC_DB_PASSWORD=
DRRAJESHKHANDELWALIBC_DB_PORT=

# The five identities remain logical scopes in ONE central physical database.
# Brand DB prefixes are identity-specific naming slots; the runtime identity layer
# continues to use the central SUPREMESETUHUB connection unless separately implemented.
# Existing WordPress databases are separate and must not be overwritten.

# FTP — same five-system naming pattern. FTP_NAME is a logical account/profile label;
# HOST and USER must be replaced with the exact Hostinger FTP account details.
# FTP password values must be stored as private secrets, never in this file.

# 1. MAIN — SUPREMESETUHUB
SUPREMESETUHUB_FTP_HOST=SUPREMESETUHUB
SUPREMESETUHUB_FTP_NAME=SUPREMESETUHUB
SUPREMESETUHUB_FTP_USER=SUPREMESETUHUB

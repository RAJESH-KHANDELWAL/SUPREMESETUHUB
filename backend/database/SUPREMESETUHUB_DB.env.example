# SUPREMESETUHUB — SINGLE CENTRAL DATABASE + SHARED FTP
# Copy these keys into the backend host's PRIVATE environment/secrets settings.
# Replace blank values only after creating the resources in Hostinger hPanel.
# This file is a template. Never put real passwords or tokens in Git.

# One physical central MariaDB/MySQL database for all five logical identities.
SUPREMESETUHUB_DB_HOST=
SUPREMESETUHUB_DB_NAME=
SUPREMESETUHUB_DB_USER=
SUPREMESETUHUB_DB_PASSWORD=
SUPREMESETUHUB_DB_PORT=3306
SUPREMESETUHUB_DB_CONNECT_TIMEOUT=10
SUPREMESETUHUB_DB_SSL_REQUIRED=false
SUPREMESETUHUB_DB_SSL_CA=

# One physical FTP account shared by five logical identity profiles.
# Use the exact FTPS host/server, account name, username and port from Hostinger.
FTP_SERVER=
FTP_NAME=
FTP_USERNAME=
FTP_PASSWORD=
FTP_PORT=21
FTP_TIMEOUT=15

# Do not add identity-specific *_FTP_* override variables unless separate
# accounts are deliberately provisioned. Blank override keys take precedence
# over shared values and can make a profile appear unconfigured.
#
# Logical scopes (not separate physical DB/FTP accounts):
# 1. SUPREMESETUHUB
# 2. RAJESHKHANDELWALOFFICIAL
# 3. RAJESHKHANDELWAL
# 4. DRRAJESHKHANDELWALIBCOFFICIAL
# 5. DRRAJESHKHANDELWALIBC

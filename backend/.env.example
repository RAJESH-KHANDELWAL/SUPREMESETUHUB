# ==============================================================
# MAIN BASE FOUNDATION
# SUPREMESETUHUB BACKEND ENVIRONMENT
# ==============================================================


# ==============================================================
# SUPREME PLATFORM
# ==============================================================

SUPREME_ADMIN_API_KEY=replace-with-a-long-random-secret
SUPREME_CONTROL_TOKEN=replace-with-a-long-random-secret

SUPREME_DB_PATH=supremesetuhub.db

# Persistent backend file storage directory (required for upload/download APIs)
# Use a persistent disk path on the backend host, not a temporary deploy directory.
SUPREME_FILE_STORAGE_DIR=


# ==============================================================
# LIVE WORDPRESS REST API (existing WordPress installations)
# Create an Application Password inside each WordPress admin user profile.
# Store the actual values only in the backend host's private Environment/Secrets.

WORDPRESS_SITE_URL=https://rajeshkhandelwalofficial.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

WORDPRESS_IBC_SITE_URL=https://drrajeshkhandelwalibc.com
WORDPRESS_IBC_USERNAME=
WORDPRESS_IBC_APPLICATION_PASSWORD=

# WORDPRESS / HOSTINGER DATABASE
# ==============================================================

WORDPRESS_DB_HOST=

WORDPRESS_DB_NAME=u664492673_hRjtu

WORDPRESS_DB_USER=

WORDPRESS_DB_PASSWORD=

WORDPRESS_DB_PORT=3306
WORDPRESS_DB_SSL_ENABLED=true

WORDPRESS_TABLE_PREFIX=wp_

# Second independent WordPress gate: DRRAJESHKHANDELWALIBC.COM
# Fill these only with the exact values from that site's Hostinger database panel.
WORDPRESS_IBC_DB_HOST=
WORDPRESS_IBC_DB_NAME=u664492673_MzL97
WORDPRESS_IBC_DB_USER=
WORDPRESS_IBC_DB_PASSWORD=
WORDPRESS_IBC_DB_PORT=3306
WORDPRESS_IBC_DB_SSL_ENABLED=true
WORDPRESS_IBC_TABLE_PREFIX=wp_

# ==============================================================
# SUPREME OWNER PRIVATE CONFIGURATION
# Set actual values in your deployment secret/environment settings.
# Never commit real values to GitHub.
# ==============================================================

SUPREME_ID=
SUPREME_OWNER_PERSON_ID=
SUPREME_OWNER_INTERNAL_USER_ID=
SUPREME_OWNER_BUSINESS_ID=
SUPREME_OWNER_COMPANY_ID=
SUPREME_OWNER_USERNAME=RAJESHKHANDELWALOFFICIAL
SUPREME_OWNER_DISPLAY_NAME=DR RAJESH KHANDELWAL IBC OFFICIAL
SUPREME_OWNER_EMAILS=
SUPREME_OWNER_PRIMARY_EMAIL=
SUPREME_OWNER_SECONDARY_EMAIL=
SUPREME_OWNER_RECOVERY_EMAIL=

# ==============================================================
# GOOGLE / GMAIL OAUTH (create credentials in Google Cloud Console)
# Owner identities are configured separately from OAuth app credentials.
# Put private account addresses in deployment secrets, not in this example file.
# ==============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Google Cloud: prefer workload identity federation or a least-privilege service account.
# Never commit service-account JSON or place credentials in frontend code.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_CREDENTIALS_JSON=
GOOGLE_CLOUD_WORKLOAD_IDENTITY_PROVIDER=

# ==============================================================
# MICROSOFT / MICROSOFT GRAPH OAUTH (Microsoft Entra app registration)
# ==============================================================

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# ==============================================================
# WHATSAPP BUSINESS CLOUD API + VERIFIED WEBHOOK
# Configure these only after creating the Meta app and WhatsApp Business setup.
# ==============================================================

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Optional AI responder; use the provider key from deployment secrets.
OPENAI_API_KEY=
WHATSAPP_AI_MODEL=gpt-4.1-mini

# SUPREME PERSONAL AI public opportunity research (Google Programmable Search)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SUPREME_PERSONAL_AI_DB=supreme_personal_ai.db

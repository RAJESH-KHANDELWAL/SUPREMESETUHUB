{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Economic activity classification crosswalk record",
  "type": "object",
  "required": ["source_classification_id", "source_version", "source_code", "target_classification_id", "target_version", "target_code", "relationship", "mapping_method", "evidence_ref", "review_status"],
  "properties": {
    "source_classification_id": {"type": "string"}, "source_version": {"type": "string"}, "source_code": {"type": "string"},
    "target_classification_id": {"type": "string"}, "target_version": {"type": "string"}, "target_code": {"type": "string"},
    "relationship": {"enum": ["exact", "broader", "narrower", "partial", "candidate"]},
    "mapping_method": {"enum": ["official_concordance", "expert_review", "rule_based", "machine_suggested"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "evidence_ref": {"type": "string"},
    "review_status": {"enum": ["unreviewed", "reviewed", "approved", "rejected"]}, "effective_from": {"type": ["string", "null"], "format": "date"}, "effective_to": {"type": ["string", "null"], "format": "date"}
  }
}

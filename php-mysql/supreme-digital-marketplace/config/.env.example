# Put these in the hosting provider's secret/environment settings. Never commit real credentials.
SUPREME_DB_HOST=127.0.0.1
SUPREME_DB_PORT=3306
SUPREME_DB_NAME=supreme_digital_marketplace
SUPREME_DB_USER=supreme_app
SUPREME_DB_PASSWORD=replace_in_server_secrets

# Configure the exact verified UPI VPA/merchant handle. A phone number alone is not assumed to be a VPA.
SUPREME_UPI_PAYEE_VPA=
SUPREME_PAYMENT_GATEWAY_KEY=
SUPREME_PAYMENT_GATEWAY_SECRET=

# Credentials from the verified PayPal merchant/business account.
SUPREME_PAYPAL_CLIENT_ID=
SUPREME_PAYPAL_CLIENT_SECRET=
SUPREME_PAYPAL_MERCHANT_EMAIL=

# Keep live checkout disabled until KYC, provider approval, tax review and webhook tests are complete.
SUPREME_PAYMENTS_LIVE_MODE=false
SUPREME_GLOBAL_CHECKOUT_DEFAULT=false

SUPREME_FX_PROVIDER=
SUPREME_FX_API_KEY=
SUPREME_TREND_PROVIDER=
SUPREME_TREND_API_KEY=
